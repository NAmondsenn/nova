[Unit]
# systemd service for Nova's brain, in its own container on PVE2 - see backend.py
# and docs/decisions/0006.
#
# This is a template. Installed as root, with the user it runs as and where the
# project is filled in:
#
#   sed -e "s|__PROJECT_DIRECTORY__|/home/nova/Home-Assistant|g" -e "s|__USER__|nova|g" \
#       -e "s|__HOME__|/home/nova|g" \
#       nova-backend.service > /etc/systemd/system/nova-backend.service
#   systemctl daemon-reload
#   systemctl enable --now nova-backend
#
# setup.sh installs it together with nova-update.path, nova-update.service and
# nova-takeback.service (see docs/decisions/0040).
Description=Nova's brain
# Tailscale passes the tailnet's connections on to it.
After=network-online.target tailscaled.service
Wants=network-online.target
# Three failed starts in ten minutes hand over to nova-takeback.service, which moves the
# code back to what it was before the last update and starts the brain again. The default
# limit never trips here - Restart=on-failure with RestartSec=10 makes six starts a minute
# at most, and the default allows five in ten seconds - so without these lines OnFailure=
# would never run. An ordinary crash loop is carried on afterwards as before, after one
# extra pause.
StartLimitIntervalSec=600
StartLimitBurst=3
OnFailure=nova-takeback.service

[Service]
# It tells systemd once it has loaded, then keeps telling it it's still working, so a
# brain which has hung is restarted rather than left sitting there - see
# voice_assistant/watchdog.py.
Type=notify
WatchdogSec=60
User=__USER__
WorkingDirectory=__PROJECT_DIRECTORY__
ExecStart=__PROJECT_DIRECTORY__/venv/bin/python __PROJECT_DIRECTORY__/backend.py

# glibc spreads threads over arenas to allocate from - up to 8 for each core - and what's
# freed in an arena below a block still in use stays with that arena rather than going
# back. Each song brings fresh threads (its download, the hand-off to ffmpeg and the feed
# to the satellite - the decoding is ffmpeg's own process), which land on different
# arenas, so during a long music session the arenas grew by about 20 MB every ten minutes
# (48 MB to 253 MB in 100 minutes, with 29 arenas) while the main heap stayed flat. With
# only two arenas the threads share them, so what one frees the next can reuse.
Environment=MALLOC_ARENA_MAX=2

# What it writes - its log, and the user's timers, alarms, memory and routines - is
# readable by its own user only, and it can never gain more privileges than it starts
# with. Everything but its own settings and data folders (and the music folder, below) is
# read-only to it - those two it needs to write, as the settings page saves settings, keys and the satellites'
# passwords in the first, and the brain keeps timers, memory and logs in the second.
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__HOME__/.config/nova __HOME__/.local/share/nova
# The music folder, where clean songs are set aside in .nova-held (decision 0022). The "-"
# lets the brain start when the share isn't mounted. A different music folder needs its own
# line, added with "systemctl edit nova-backend" so a re-install keeps it.
ReadWritePaths=-/mnt/music

# Loading Piper and Nemotron takes a few seconds; a crash is restarted after a short pause.
TimeoutStartSec=120
Restart=on-failure
RestartSec=10
# The settings page's Restart stops the brain cleanly, then exits with this status
# (RESTART_EXIT_STATUS in voice_assistant/brain.py), as the nova user can't ask
# systemd itself.
RestartForceExitStatus=75

[Install]
WantedBy=multi-user.target
